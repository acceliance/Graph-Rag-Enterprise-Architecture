# =============================================================================
#  Acceliance Graph-RAG — environment (copy to .env, never commit .env)
#
#  scripts/up.sh and scripts/up.ps1 create .env from this file and fill in the
#  two secrets automatically. Doing it by hand: set the two REQUIRED lines.
# =============================================================================

# ── REQUIRED secrets ─────────────────────────────────────────────────────────
#  No fallback: docker compose refuses to start without them.
#  Generate (bash):        openssl rand -base64 24 | tr -d '+/='
#  Generate (PowerShell):  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#  Avoid $ ` " and \ in NEO4J_PASSWORD: it is reassembled into "neo4j/<password>".
NEO4J_PASSWORD=
QDRANT_API_KEY=

# ── Product images ───────────────────────────────────────────────────────────
#  Published on Docker Hub, public — no login needed. Pin a release tag rather
#  than `latest` in production, and update both together.
GRAPHRAG_API_IMAGE=acceliance/graphrag-api:latest
GRAPHRAG_WEB_IMAGE=acceliance/graphrag-web:latest

# ── Datastore images ─────────────────────────────────────────────────────────
#  Exact patch versions verified on Docker Hub on 2026-09-21. Neo4j 5.26 is the
#  LTS line; Qdrant 1.15 is the line the API is tested against.
QDRANT_TAG=v1.15.5
NEO4J_TAG=5.26.30-community

# ── Network ──────────────────────────────────────────────────────────────────
#  The only published port. Behind a reverse proxy on the same host, bind to
#  127.0.0.1 so the plain-HTTP port is not reachable from the network.
GRAPHRAG_HTTP_BIND=0.0.0.0
GRAPHRAG_HTTP_PORT=8080

# ── Session ──────────────────────────────────────────────────────────────────
#  `Secure` cookie ⇒ the site MUST be served over HTTPS (reverse proxy).
#  false only for a pilot reached over plain http://host:8080.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=43200

# ── Authentication mode ──────────────────────────────────────────────────────
#  Needs product images that include it (see the release notes); an older web
#  image refuses to start in any mode but standalone. Choose ONE:
#     standalone  accounts and passwords managed by the application (default)
#     office365   Microsoft 365 / Entra ID, OIDC through the oauth2-proxy sidecar
#     google      Google Workspace, OIDC through the oauth2-proxy sidecar
#     azure       Entra ID carried by Azure Container Apps "Easy Auth" (no sidecar)
#  In every federated mode, accounts still live in Admin ▸ Users (role, active):
#  the IdP says WHO signs in, the application WHAT they may do. On an empty
#  account store, the first person the IdP lets in becomes administrator.
#  MCP, A2A and the public query API are never behind the IdP: they keep their
#  own bearer key, and accept OAuth access tokens when MCP_OAUTH_* is set below.
AUTH_MODE=standalone
#
#  office365 / google: start the sidecar with the stack (docker compose reads
#  this line), and declare on the IdP side the redirect URI
#  https://<your-host>/oauth2/callback
# COMPOSE_PROFILES=federated
#
#  office365 (Entra ID app registration, "Web" platform):
# OAUTH2_PROVIDER=oidc
# OAUTH2_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OAUTH2_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OAUTH2_CLIENT_SECRET=change_me
#
#  google (Google Cloud Console ▸ OAuth 2.0 Client ID, "Web application"):
# OAUTH2_PROVIDER=google
# OAUTH2_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OAUTH2_CLIENT_SECRET=change_me
#
#  Common to office365 and google:
#  Restrict sign-in to one e-mail domain (* = any account the IdP accepts).
# OAUTH2_EMAIL_DOMAIN=example.com
#  Session cookie encryption secret, 16/24/32 bytes:
#     python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# OAUTH2_COOKIE_SECRET=change_me
# OAUTH2_REDIRECT_URL=https://<your-host>/oauth2/callback
# OAUTH2_COOKIE_DOMAIN=<your-host>
# OAUTH2_COOKIE_EXPIRE=12h
# OAUTH2_SCOPE=openid email profile
#
#  azure: configure Authentication on the Container App (Entra ID provider,
#  unauthenticated action "redirect to login") and exclude the machine paths:
#  /healthz /api/mcp /api/mcp/* /api/a2a /api/.well-known/* /api/public/*
#  /api/health /api/version /.well-known/oauth-protected-resource/*

# ── Sizing (see README "Sizing") ─────────────────────────────────────────────
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
#  true keeps vectors on disk (large corpora on hosts under 16 GB RAM).
QDRANT_ON_DISK_VECTORS=false

# ── Ingestion limits ─────────────────────────────────────────────────────────
GRAPHRAG_MAX_UPLOAD_MB=50
GRAPHRAG_MAX_PAGES=500
#  Tesseract languages used for pages without a text layer (packs shipped in
#  the image: fra, eng).
GRAPHRAG_OCR_LANGS=fra+eng
#  Auto-purge documents older than N days (0 = off).
GRAPHRAG_RETENTION_DAYS=0

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERS=10
AGENT_MAX_TOKENS=4096

# ── MCP (external AI hosts) ──────────────────────────────────────────────────
#  Leave MCP_ENABLED unset to administer the switch from Admin ▸ MCP.
#  MCP_ENABLED=false locks the feature for this deployment.
# MCP_ENABLED=
#  REQUIRED as soon as a host connects through anything but localhost, else
#  every client gets 421. Host AND port actually used by clients:
#     graphrag.example.com:*      one host, any port
#     *                           disables the check (only behind a trusted edge)
# MCP_ALLOWED_HOSTS=graphrag.example.com:*
# MCP_ALLOWED_ORIGINS=
#
#  OAuth on the MCP endpoint (optional, NEXT TO the key, never instead of it):
#  people connect Claude / VS Code / any MCP client WITHOUT a key - the client
#  opens their organisation's sign-in page and gets a token. Graph-RAG only
#  verifies it (signature, issuer, audience, expiry, scope) and maps its e-mail
#  to an ACTIVE account of Admin ▸ Users, whose role applies (an analyst cannot
#  ingest). The key keeps serving scripts and servers as the `mcp` analyst.
#  Leave MCP_OAUTH_ISSUER empty for key-only.
#
#  Microsoft Entra ID - app registration "Graph-RAG MCP":
#   - Expose an API: Application ID URI api://<app-id>, scope `mcp.access`;
#   - Manifest: "requestedAccessTokenVersion": 2  (else tokens carry the v1
#     issuer https://sts.windows.net/<tenant>/ and are refused);
#   - Authentication: add the redirect URI(s) of your MCP client, e.g. for Claude
#     https://claude.ai/api/mcp/auth_callback; Entra has no dynamic client
#     registration, so give the client this app's client ID (and a secret if it
#     is a confidential client) in the connector's advanced settings.
#
#  Example (uncomment and replace the tenant and app ids with yours; both are on
#  the app registration's Overview page):
#     tenant id (Directory ID)     11111111-2222-3333-4444-555555555555
#     app id (Application ID)      aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# MCP_OAUTH_ISSUER=https://login.microsoftonline.com/11111111-2222-3333-4444-555555555555/v2.0
# MCP_OAUTH_AUDIENCE=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee   # v2 tokens: aud = the app id GUID
# MCP_OAUTH_RESOURCE=https://graphrag.example.com/api/mcp   # public URL clients use, ending in /mcp
# MCP_OAUTH_SCOPES=api://aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee/mcp.access
#  Optional:
# MCP_OAUTH_JWKS_URL=                              # else discovered from the issuer
# MCP_OAUTH_EMAIL_CLAIMS=email,preferred_username,upn
# MCP_OAUTH_AUTHORIZATION_SERVERS=                 # advertised instead of the issuer
#  A2A and the public query API accept the SAME tokens (same app registration
#  and scope); their resources are MCP_OAUTH_RESOURCE with /mcp -> /a2a and
#  /mcp -> /public unless set here. On the public API a token reaches the
#  published queries, and free GraphQL for an administrator's account.
# A2A_OAUTH_RESOURCE=https://graphrag.example.com/api/a2a
# PUBLIC_API_OAUTH_RESOURCE=https://graphrag.example.com/api/public

# ── A2A (Agent2Agent v1.0) ───────────────────────────────────────────────────
#  Administered from Admin ▸ A2A; authenticates with the MCP key, or with an
#  OAuth access token when MCP OAuth is configured above (the caller's own role).
#  Leave A2A_ENABLED unset to administer the switch from the screen;
#  false locks the feature for this deployment; true enables it at start.
# A2A_ENABLED=
#  Externally visible base URL written into the Agent Card (needed behind a
#  host-rewriting or TLS-terminating proxy).
# A2A_PUBLIC_URL=https://graphrag.example.com/api

# ── Misc ─────────────────────────────────────────────────────────────────────
TZ=Europe/Paris
#  Escape hatch, never for production: run without a Qdrant API key.
GRAPHRAG_ALLOW_UNSECURED_QDRANT=false
#  DANGER — Admin ▸ Database "clean the whole database" deletes the model,
#  every document, the graph and the vectors (irreversible). Refused unless
#  true; enable only for the time it is needed.
GRAPHRAG_ALLOW_PURGE=false

# ── NOT configured here, on purpose ──────────────────────────────────────────
#  AI provider keys (Anthropic, OpenAI), on-premises server URL and context
#  window, model names for the chat / extraction / embedding slots: entered
#  after installation from Admin ▸ AI settings, stored under ./data/api, and
#  re-read on every request. Keeping them out of this file means no deployment
#  input ever holds a secret.
